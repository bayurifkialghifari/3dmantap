{
  "name": "@3dmantap/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun build src/index.ts src/worker.ts --target=bun --outdir dist --packages external",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@3dmantap/shared": "workspace:*",
    "better-auth": "^1.7.20",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "hono": "^4.13.18",
    "mysql2": "^3.15.3",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "drizzle-kit": "^0.31.4"
  }
}
